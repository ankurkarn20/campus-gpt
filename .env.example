# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://campusgpt:CHANGE_ME@localhost:5432/campusgpt
TEST_DATABASE_URL=postgresql+psycopg://campusgpt:CHANGE_ME@localhost:5432/campusgpt_test
# Password for the demo accounts created by the seed command (optional)
# DEMO_PASSWORD=campusgpt-demo

# Chat model (OpenAI-compatible). Free key: https://console.groq.com/keys
LLM_API_KEY=
# Defaults: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
# Gemini instead: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                 LLM_MODEL=gemini-3.8-flash   (key: https://aistudio.google.com/apikey)

# Document search: embedding model (downloaded once, ~65 MB) and where it is cached
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MODEL_CACHE_DIR=~/.cache/campusgpt/models
